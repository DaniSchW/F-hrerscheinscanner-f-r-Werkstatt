# Build-Zeit-Konfiguration für den Next.js-Frontend-Export (`npm run build`).
# Wird beim Build in den Client-Bundle eingebettet - hier stehen bewusst
# keine Geheimnisse. Die eigentliche Server-Konfiguration (DB, Claude-API-Key,
# Verschlüsselung) liegt in server/config.php - siehe server/config.example.php.

# Pfad zum PHP-Backend, relativ zur Domain. Standard passt, wenn Next-Export
# (out/) und server/ auf derselben Domain im selben Wurzelverzeichnis liegen
# (empfohlenes Kasserver-Setup, kein CORS nötig).
NEXT_PUBLIC_API_BASE_URL="/server/api"

# Minuten Inaktivität, bevor sich der Bildschirm sperrt (Briefing Abschnitt 2)
NEXT_PUBLIC_INACTIVITY_TIMEOUT_MINUTES=45
