# PostgreSQL, EU-gehostet (DSGVO) - z.B. lokal via docker-compose.yml
DATABASE_URL="postgresql://fs_scanner:fs_scanner@localhost:5432/fuehrerscheinscanner"

# Anthropic API-Key für die Claude Vision Datenextraktion
ANTHROPIC_API_KEY=""
# Optional: Modell überschreiben (Standard: claude-sonnet-5)
ANTHROPIC_MODEL="claude-sonnet-5"

# Geheimes Token für den Cronjob, der /api/cron/loeschung aufruft
# Erzeugen z.B. mit: openssl rand -hex 32
CRON_SECRET=""

# 32-Byte-Schlüssel (Base64) zur Verschlüsselung der Unterschrift at rest
# Erzeugen mit: openssl rand -base64 32
SIGNATURE_ENCRYPTION_KEY=""

# Aufbewahrungsfrist in Monaten nach Rückgabe, bevor Führerschein-/Kundendaten
# automatisch gelöscht werden (Abschnitt 8 des Briefings - vom Betrieb festzulegen)
RETENTION_MONTHS=12

# Minuten Inaktivität, bevor sich der Bildschirm sperrt (Abschnitt 2)
INACTIVITY_TIMEOUT_MINUTES=45

# Ablageort für dauerhaft gespeicherte Dateien (Zustandsfotos, verschlüsselte
# Unterschrift). Für den Produktivbetrieb gegen EU-Objektspeicher austauschen -
# siehe src/lib/storage.ts.
UPLOAD_DIR="./uploads"

# Nur für das Seed-Skript (prisma/seed.ts) - Erstanmeldedaten des Admin-Accounts
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORT="bitte-aendern-123"
